<?xml version="1.0" encoding="utf-8"?>
<!-- ChromaSol (ColorsApp) para Android.
     SIN PERMISO DE INTERNET, como en iOS: `make android-lint` falla si el
     manifiesto fusionado de release declara INTERNET o cualquier permiso de
     red. Tampoco se piden permisos de fotos en esta fundación: la ola 2 usará
     el selector de fotos del sistema (sin permiso) y, para el escaneo del
     carrete, READ_MEDIA_IMAGES / acceso limitado (ver docs/ANDROID.md).
     Solo vertical, como iOS (UISupportedInterfaceOrientations = Portrait). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".app.ColorsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChromaSol">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChromaSol"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- W4: compartir tarjetas/capas/diagnósticos por Intent (sin red). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/w4_file_paths" />
        </provider>
    </application>
</manifest>
